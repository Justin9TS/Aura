# Copy this file to `.env` and fill in your own keys. Never commit .env.

# --- Stripe (payments) ---
# From https://dashboard.stripe.com/test/apikeys — starts with sk_test_
# while testing, sk_live_ when you go live.
STRIPE_SECRET_KEY=

# Optional, for production: from your Stripe webhook endpoint settings,
# starts with whsec_. Enables server-to-server payment confirmation.
STRIPE_WEBHOOK_SECRET=

# --- Discord (order log) ---
# Channel settings -> Integrations -> Webhooks. Every order gets posted
# to this channel. Treat it like a password.
DISCORD_WEBHOOK_URL=

# --- Email (verification codes + password reset) ---
# Any SMTP provider works (e.g. Resend, Mailgun, Gmail app password).
# Leave empty and accounts activate instantly with no codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# For local testing without an email provider: set EMAIL_DEBUG=1 and the
# codes are printed in the server console instead of emailed.
# EMAIL_DEBUG=1

# Set to "production" on your real host (turns on secure cookies).
# NODE_ENV=production

# --- Admin ---
# The ONE account allowed to open /admin.html. Create a normal account
# on the store with this email, then sign in — the dashboard appears.
# Anyone else gets a "Not found" page.
ADMIN_EMAIL=
